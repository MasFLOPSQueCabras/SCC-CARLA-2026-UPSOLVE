#version=RHEL10
# Non-interactive text/cmdline installation and shutdown for media removal upon completion
cmdline
poweroff

# Installation source directly from the mounted minimal ISO
cdrom

# Localization
lang en_US.UTF-8
keyboard us
timezone America/Argentina/Cordoba --utc

# Network configuration
network --bootproto=static --ip={{ node_ip }} --netmask={{ netmask }} --gateway={{ gateway_ip }} --nameserver={{ dns_ip }} --device={{ node_macs[hostname] }} --activate --onboot=yes --hostname={{ hostname }}

# Storage configuration
bootloader --location=mbr
zerombr
{% if target_disk %}
ignoredisk --only-use={{ target_disk }}
clearpart --all --initlabel --drives={{ target_disk }}
{% else %}
clearpart --all --initlabel
{% endif %}
autopart --type=plain

# User & Security configuration
rootpw --lock
user --name={{ node_username }} --groups=wheel --plaintext --password="!"
sshkey --username={{ node_username }} "{{ pubkey }}"

# Firewall & SELinux
firewall --enabled --ssh
selinux --enforcing

# Package selection (Minimal BaseOS with python3 for Ansible)
%packages --ignoremissing
@core
openssh-server
sudo
python3
curl
tar
%end

# Post-installation hardening & sudoers configuration
%post --log=/root/ks-post.log
# Sudoers without password prompt
echo "{{ node_username }} ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/{{ node_username }}
chmod 0440 /etc/sudoers.d/{{ node_username }}

# Ensure authorized_keys
mkdir -p /home/{{ node_username }}/.ssh
echo "{{ pubkey }}" >> /home/{{ node_username }}/.ssh/authorized_keys
chmod 700 /home/{{ node_username }}/.ssh
chmod 600 /home/{{ node_username }}/.ssh/authorized_keys
chown -R {{ node_username }}:{{ node_username }} /home/{{ node_username }}/.ssh

# Harden sshd: permit user key login, disable root login
mkdir -p /etc/ssh/sshd_config.d
cat << 'EOF' > /etc/ssh/sshd_config.d/01-carla.conf
PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
EOF

systemctl enable sshd
%end

%pre --erroronfail --log=/tmp/cabrita-disk-check.log
set -eu
actual=$(lsblk -dn -o SERIAL /dev/{{ target_disk }} | xargs)
expected={{ disk_serials[hostname] }}
if [ "$actual" != "$expected" ]; then
    echo "Refusing install: expected NVMe serial $expected, found $actual" >&2
    exit 1
fi
%end
