#version=RHEL10
# Non-interactive text/cmdline installation and automatic reboot upon completion
cmdline
reboot --eject

# Installation source directly from the mounted minimal ISO
cdrom

# Localization
lang en_US.UTF-8
keyboard us
timezone America/Argentina/Cordoba --utc

# Network configuration
network --bootproto=static --ip={{ node_ip }} --netmask=255.255.255.0 --gateway={{ gateway_ip }} --nameserver={{ dns_ip }} --device=link --activate --hostname={{ hostname }}

# Storage configuration (UEFI & 800GB SSD)
bootloader --location=mbr
zerombr
clearpart --all --initlabel
autopart --type=plain

# User & Security configuration
rootpw --lock
user --name={{ node_username }} --groups=wheel --plaintext --password="!"
sshkey --username={{ node_username }} "{{ pubkey }}"

# Firewall & SELinux
firewall --enabled --ssh
selinux --enforcing

# Package selection (Minimal BaseOS)
%packages --ignoremissing
@core
openssh-server
sudo
curl
tar
infiniband-diags
libibverbs-utils
perftest
rdma-core
%end

# Post-installation hardening & sudoers configuration
%post --log=/root/ks-post.log
# Sudoers without password prompt
echo "{{ node_username }} ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/{{ node_username }}
chmod 0440 /etc/sudoers.d/{{ node_username }}

# Harden sshd: permit user key login, disable root login
sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config

systemctl enable sshd

# Ensure InfiniBand diagnostic and benchmark packages are installed
dnf install -y infiniband-diags libibverbs-utils perftest rdma-core || true

# RDMA unlimited memory locking limits
cat > /etc/security/limits.d/99-rdma.conf << 'EOF'
* soft memlock unlimited
* hard memlock unlimited
* soft stack 32768
* hard stack 32768
EOF

# InfiniBand / IPoIB Network Configuration
nmcli con mod ibs5f0 ipv4.addresses {{ ib_ip }}/24 ipv4.method manual autoconnect yes || nmcli con add type infiniband con-name ib0 ifname ibs5f0 ip4 {{ ib_ip }}/24 autoconnect yes || true
firewall-cmd --zone=trusted --change-interface=ibs5f0 --permanent || true

# Cluster /etc/hosts resolution
cat >> /etc/hosts << 'EOF'
10.2.72.1 node1
10.2.72.2 node2
10.2.72.3 node3
10.10.72.1 node1-ib
10.10.72.2 node2-ib
10.10.72.3 node3-ib
EOF

%end
