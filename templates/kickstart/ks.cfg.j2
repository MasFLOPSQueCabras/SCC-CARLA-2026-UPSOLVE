#version=RHEL10
# Non-interactive text/cmdline installation and automatic reboot upon completion
cmdline
reboot

# Installation source directly from the mounted minimal ISO
cdrom

# Localization
lang en_US.UTF-8
keyboard us
timezone America/Argentina/Cordoba --utc

# Network configuration
network --bootproto=static --ip={{ node_ip }} --netmask=255.255.255.0 --gateway={{ gateway_ip }} --nameserver={{ dns_ip }} --device=link --activate --hostname={{ hostname }}

# Storage configuration (UEFI & 800GB SSD)
bootloader --location=mbr
zerombr
clearpart --all --initlabel
autopart --type=plain

# User & Security configuration
rootpw --lock
user --name={{ node_username }} --groups=wheel --plaintext --password="!"
sshkey --username={{ node_username }} "{{ pubkey }}"

# Firewall & SELinux
firewall --enabled --ssh
selinux --enforcing

# Package selection (Minimal BaseOS with python3 for Ansible)
%packages --ignoremissing
@core
openssh-server
sudo
python3
curl
tar
%end

# Post-installation hardening & sudoers configuration
%post --log=/root/ks-post.log
# Sudoers without password prompt
echo "{{ node_username }} ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/{{ node_username }}
chmod 0440 /etc/sudoers.d/{{ node_username }}

# Harden sshd: permit user key login, disable root login
sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config

systemctl enable sshd
%end
