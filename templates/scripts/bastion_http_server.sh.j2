#!/usr/bin/env bash
set -euo pipefail

BIND_IP="{{ bind_ip }}"
PORT="{{ port }}"
SERVE_DIR="{{ serve_dir }}"

mkdir -p "${SERVE_DIR}"
cd "${SERVE_DIR}"

# Terminate any existing instance on this port
fuser -k "${PORT}/tcp" 2>/dev/null || pkill -f "RangeHTTPServer.*${PORT}" 2>/dev/null || true

python3 - <<'EOF' "${BIND_IP}" "${PORT}" "${SERVE_DIR}"
import functools
import http.server
import os
import sys

from RangeHTTPServer import RangeRequestHandler

bind_ip = sys.argv[1]
port = int(sys.argv[2])
serve_dir = sys.argv[3]

os.chdir(serve_dir)
handler = functools.partial(RangeRequestHandler, directory=serve_dir)
server = http.server.ThreadingHTTPServer((bind_ip, port), handler)
print("READY", flush=True)
server.serve_forever()
EOF
