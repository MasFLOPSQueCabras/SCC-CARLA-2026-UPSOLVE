#!/bin/bash
set -euo pipefail
benchmark_dir={{ (nfs_mount_dir + '/hpl') | quote }}
mkdir -p "$benchmark_dir/results"
result_dir=$(mktemp -d "$benchmark_dir/results/run.XXXXXX")
cp "$benchmark_dir/HPL.dat" "$result_dir/HPL.dat"
cd "$result_dir"
export OMP_NUM_THREADS={{ omp_threads }}
export OPENBLAS_NUM_THREADS={{ omp_threads }}
export PATH={{ (mpi_launcher | dirname) | quote }}:"$PATH"
export LD_LIBRARY_PATH={{ mpi_library_path | quote }}:${LD_LIBRARY_PATH:-}
{% if transport == 'ucx' %}
export UCX_NET_DEVICES={{ ucx_device | quote }}
export UCX_TLS=rc,sm,self
{% endif %}
{{ mpi_launcher | quote }} -np {{ hpl_ranks }} --hostfile "$benchmark_dir/hosts" --bind-to core \
    -x PATH -x LD_LIBRARY_PATH -x OMP_NUM_THREADS -x OPENBLAS_NUM_THREADS \
{% if transport == 'tcp' %}
    --mca pml ob1 --mca btl self,tcp \
{% else %}
    --mca pml ucx -x UCX_NET_DEVICES -x UCX_TLS \
{% endif %}
    {{ mpi_args | map('quote') | join(' ') }} {{ resolved_hpl_binary | quote }} | tee "$result_dir/HPL.out"
python3 "$benchmark_dir/check_result.py" "$result_dir/HPL.out"
printf 'Results: %s\n' "$result_dir"
