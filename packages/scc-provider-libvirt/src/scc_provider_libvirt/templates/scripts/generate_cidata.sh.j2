#!/usr/bin/env bash
set -euo pipefail

# Parameters
OUTPUT_IMG="{{ output_img }}"
USER_DATA="{{ user_data_path }}"
META_DATA="{{ meta_data_path }}"
NETWORK_CONFIG="{{ network_config_path }}"
SIZE_MB="{{ size_mb | default(4) }}"

# 1. Allocate blank zeroed image
dd if=/dev/zero of="${OUTPUT_IMG}" bs=1M count="${SIZE_MB}" status=none

# 2. Format with FAT filesystem labeled CIDATA
mkfs.vfat -n CIDATA "${OUTPUT_IMG}" >/dev/null

# 3. Copy cloud-init configuration files into the root of CIDATA
mcopy -i "${OUTPUT_IMG}" "${USER_DATA}" ::user-data
mcopy -i "${OUTPUT_IMG}" "${META_DATA}" ::meta-data
mcopy -i "${OUTPUT_IMG}" "${NETWORK_CONFIG}" ::network-config
